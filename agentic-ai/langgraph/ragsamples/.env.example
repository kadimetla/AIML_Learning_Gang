OPENAI_API_KEY=sk-...
# Models
EMBED_MODEL=text-embedding-3-small
CHAT_MODEL=gpt-4o-mini

# Vector store backend: chroma | qdrant | pgvector
VECTOR_BACKEND=chroma
COLLECTION=documents

# chroma: local persistent dir
CHROMA_DIR=./data/chroma
# qdrant: leave QDRANT_URL empty for embedded local mode (QDRANT_PATH), or e.g. http://localhost:6333
QDRANT_URL=
QDRANT_PATH=./data/qdrant
# pgvector (docker compose up -d postgres)
PG_CONN=postgresql+psycopg://rag:rag@localhost:5432/rag

# Service ports
INGEST_PORT=8001
QUERY_PORT=8002
