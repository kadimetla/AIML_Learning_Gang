OPENAI_API_KEY=
MODEL=litellm:gpt-4o-mini
CLOUD_PROVIDER=fake
# CLOUD_PROVIDER=aws also needs AWS credentials (profile or AWS_* vars); AWS_ENDPOINT_URL=http://localhost:4566 for LocalStack
# optional: a stronger model only for designing A2UI views in web_shadcn (e.g. litellm:gpt-4o)
# A2UI_MODEL=
# minutes an approval stays valid (a later "yes" is refused and the plan must be proposed again)
# APPROVAL_TTL_MIN=30
# Postgres for checkpoints (threads, approval pauses) and long-term memory: `docker compose up -d`
DATABASE_URL=postgresql://provisioner:provisioner@127.0.0.1:5434/provisioner
# embeddings for recalling similar past cases (change both together; the store's vector size is fixed at setup)
# EMBED_MODEL=text-embedding-3-small
# EMBED_DIMS=1536
# until there is auth, server.py runs every request as this tenant / user
# DEV_TENANT=dev-tenant
# DEV_USER=dev-user
